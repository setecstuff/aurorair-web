# Copy to .env and adjust. Never commit .env. All times are UTC.

# --------------------------------------------------------------------------- administrator
ADMIN_USERNAME=admin
# Used to create the admin on the FIRST start only (min 12 characters). Changing it later has no effect,
# unless ADMIN_FORCE_RESET=true.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
# Recovery: when true, EVERY start removes the admin's MFA and IP allowlist and sets the password to
# ADMIN_PASSWORD. Set it, redeploy, sign in, then set it back to false and redeploy again.
ADMIN_FORCE_RESET=false

# Required: encrypts TOTP secrets and the MISP/VirusTotal API keys stored in the database.
# At least 32 random characters, e.g.  openssl rand -base64 48
# Keep it safe and keep it the same: a restored database needs the SECRET_KEY it was written with.
SECRET_KEY=

# --------------------------------------------------------------------------- two-factor authentication
# Read on every start. true = users without MFA must enrol an authenticator (TOTP) right after signing in.
MFA_ENFORCED=false
# MFA_ISSUER=Aurora IR Web           # name shown in the authenticator app

# --------------------------------------------------------------------------- database (MariaDB / MySQL)
# See docs/installation.md.
# Single instance (default): keep COMPOSE_PROFILES=bundled-db and leave DB_HOST unset -> the internal MariaDB
# container ("db") is used. It creates the database and user below the first time only.
# External / managed server: set DB_HOST (and DB_PORT) and delete or empty COMPOSE_PROFILES. The DBA must create
# the database, the user and the schema (docs/schema.sql) there before the first deploy.
COMPOSE_PROFILES=bundled-db
# DB_HOST=db.corp.lan
# DB_PORT=3306
DB_NAME=aurora
DB_USER=aurora
# Required. A long random password (bundled: chosen here; external: the password of your database user).
DB_PASSWORD=
# DB_SSL_CA=/run/certs/db-ca.pem     # external server: require TLS, verified with this CA (mount the file)
# DB_POOL_SIZE=10

# --------------------------------------------------------------------------- web
# true when served over HTTPS through your reverse proxy (recommended / default)
COOKIE_SECURE=true
# IP address(es) of the reverse proxy (comma separated) or * if only the proxy can reach the container
FORWARDED_ALLOW_IPS=*
BIND_ADDRESS=127.0.0.1
PORT=8083
# WEB_WORKERS=2

# Optional tuning
# SESSION_IDLE_MINUTES=480
# SESSION_MAX_HOURS=24
# MAX_IMPORT_MB=25
# MAX_RESTORE_MB=2048
# Maximum total records (all sections) per case; 0 = unlimited. Guards storage against an authenticated abuser.
# MAX_RECORDS_PER_CASE=200000
# Per-principal rate limits on expensive ops (0 = unlimited): exports/min and on-demand backups/hour.
# EXPORT_RATE_PER_MIN=60
# BACKUP_RATE_PER_HOUR=12
# MIN_PASSWORD_LENGTH=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------------------------------- activity log
# Entries older than this many weeks are deleted daily. 0 = keep forever.
AUDIT_RETENTION_WEEKS=0

# --------------------------------------------------------------------------- MISP / VirusTotal row actions
# (called by the server; keys are set per case in Case Details)
# INTEGRATIONS_ENABLED=true
# INTEGRATIONS_TIMEOUT=15
# INTEGRATIONS_CA_FILE=/run/certs/internal-ca.pem   # trust an internal CA for MISP (mount the file)
# MISP_VERIFY_TLS=true
# MISP_ALLOW_HTTP=false
# true (default): an internal MISP on a private network (10/8, 172.16/12, 192.168/16) is allowed. false refuses
# private ranges; loopback / link-local / cloud-metadata are always refused.
# MISP_ALLOW_PRIVATE=true
# MISP_ALLOWED_HOSTS=misp.corp.lan                 # restrict MISP to these hosts

# --------------------------------------------------------------------------- backups (database snapshots)
# Daily snapshot (mysqldump) at BACKUP_TIME_UTC, plus on demand in Administration -> Backups & Restore.
BACKUP_ENABLED=true
BACKUP_TIME_UTC=02:00
BACKUP_KEEP=30
# true = encrypt every snapshot to the PGP public key below (gpg). Decrypt with your private key before
# a restore:  gpg --decrypt aurora-....sql.gz.gpg > aurora-....sql.gz
BACKUP_ENCRYPT=false
# ASCII-armored PGP public key (an encryption-capable key), between double quotes, on several lines.
# Keep this the LAST variable of the file.
BACKUP_PGP_PUBLIC_KEY=""
